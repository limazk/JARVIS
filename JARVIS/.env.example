# ===================================================
# JARVIS — configuração (copie para .env e preencha)
# NUNCA coloque suas chaves reais neste arquivo .env.example
# ===================================================

# ----- Identidade -----
JARVIS_NAME=Jarvis
LANGUAGE=pt-BR
DEBUG=false
# Como o Jarvis se dirige a você (ex.: "Senhor", "Senhora", "Chefe").
# Deixe em branco (USER_TITLE=) para ele parar de usar qualquer
# forma de tratamento e falar de forma neutra.
USER_TITLE=Senhor

# ----- Comportamento -----
VOICE_ENABLED=true
# Modo "sempre ouvindo" tipo Alexa: rode `python main.py --voice` com isto
# ligado, diga "jarvis" e o Jarvis responde em voz ("Sim, Senhor. O que
# deseja?") antes de escutar seu comando. Recomendado: pip install
# openwakeword (veja requirements.txt) pra detecção 100% local.
WAKE_WORD_ENABLED=true
WAKE_WORD=jarvis
WAKE_WORD_MODEL=hey_jarvis
# O que o Jarvis fala ao ouvir a wake word, antes do comando. Vazio = ele
# monta sozinho a partir de USER_TITLE (ex.: "Sim, Senhor. O que deseja?").
WAKE_GREETING=
# Ações CRITICAL (ex.: nada implementado por padrão) ficam bloqueadas
# a menos que você ligue isto conscientemente:
ALLOW_CRITICAL_ACTIONS=false

# ----- LLM (cérebro) -----
# claude | openai | gemini | groq | local
LLM_PROVIDER=local
# Se LLM_PROVIDER falhar (limite estourado, sem crédito, fora do ar) ou não
# estiver configurado, cai sozinho pros gratuitos: Gemini -> Groq -> Ollama
# local. Nunca troca entre dois provedores PAGOS sozinho (só desce pros
# gratuitos). Coloque "false" para desligar e usar só o LLM_PROVIDER escolhido.
LLM_AUTO_FALLBACK=true

# Claude e OpenAI são pagos por uso (sem camada grátis contínua).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ----- Gemini (GRÁTIS, sem cartão de crédito) -----
# Gere em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ----- Groq (GRÁTIS, sem cartão de crédito, inferência bem rápida) -----
# Gere em: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Modelo local via Ollama — 100% grátis e offline, sem conta nenhuma.
# Instale o Ollama (https://ollama.com) e baixe um modelo antes
# (`ollama pull qwen3.5:9b`).
LOCAL_LLM_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen3.5:9b
LOCAL_LLM_CONTEXT=8192
LOCAL_LLM_TEMPERATURE=0.6
LOCAL_LLM_THINKING=false
# Quanto tempo (em segundos) esperar pelo Ollama antes de desistir.
# Modelos locais rodando em CPU podem ser bem mais lentos que provedores
# em nuvem, principalmente modelos maiores (ex.: qwen2.5:14b) ou na
# primeira resposta depois de abrir o Jarvis. Aumente se sua máquina for
# mais lenta e ainda assim receber "modelo local indisponível".
LOCAL_LLM_TIMEOUT=180
# Quanto tempo o Ollama mantém o modelo carregado na RAM/VRAM depois da
# última mensagem (padrão do Ollama é só 5 minutos — aumentar isso evita
# que cada resposta, depois de uma pausa, pague o custo de recarregar o
# modelo do disco do zero). Aceita formatos como "30m", "1h", ou "-1"
# para nunca descarregar.
OLLAMA_KEEP_ALIVE=15m

# ----- Voz (a partir da ETAPA 5) -----
# google (grátis, online) | whisper (local)
STT_PROVIDER=google
# edge (grátis, online) | pyttsx3 (offline) | elevenlabs (pago)
TTS_PROVIDER=edge
EDGE_TTS_VOICE=pt-BR-AntonioNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ----- Clima -----
OPENWEATHER_API_KEY=
WEATHER_CITY=Brasilia,BR

# ----- GitHub (opcional — só necessário para list_my_repos/repo_info/create_issue) -----
# Gere em: GitHub > Settings > Developer settings > Personal access tokens (classic)
# Escopos: repo, read:user
GITHUB_TOKEN=
GITHUB_USERNAME=

# ----- Mercado Pago (opcional — vendas, cobranças e saldo) -----
# Gere em: https://www.mercadopago.com.br/developers/panel > Suas integrações
# > crie uma aplicação > aba Credenciais (produção ou teste) > Access Token
MERCADOPAGO_ACCESS_TOKEN=

# ----- Spotify (opcional — controle de reprodução: tocar/pausar/pular/volume) -----
# 1) Crie um app grátis em https://developer.spotify.com/dashboard
# 2) Em "Redirect URIs" do app, cadastre EXATAMENTE: http://127.0.0.1:8888/callback
# 3) Cole o Client ID e o Client Secret do app abaixo
# Observação: tocar/pausar/pular/volume exige conta Spotify Premium (restrição
# da própria Spotify) — consultar "o que está tocando" funciona no plano grátis.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ----- Bot do Discord (opcional — conversar com o Jarvis de fora do PC) -----
# Veja o passo a passo completo em interface/discord_bot.py ou no README.
# DISCORD_OWNER_ID é o ID numérico da SUA conta — o bot ignora qualquer
# outra pessoa por segurança (o Jarvis tem ferramentas de risco alto).
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=

# ----- ROTINA (API local; nunca versione a chave real) -----
ROTINA_ENABLED=true
ROTINA_URL=http://127.0.0.1:8765
ROTINA_KEY=
# Vazio = procura ../ROTINA ao lado da pasta JARVIS.
ROTINA_DIR=
ROTINA_AUTO_START=true
# Só encerra no shutdown se o próprio JARVIS iniciou o ROTINA.
ROTINA_STOP_ON_EXIT=false
FAST_CACHE_ENABLED=true
FAST_CACHE_TTL=15
